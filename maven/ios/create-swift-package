#!/bin/bash
set -euo pipefail

# create-swift-package generates a Package.swift manifest exposing the passport
# .xcframework zip as a Swift Package Manager binary target, plus a Swift target
# for the UniFFI bindings (ooniprobe.swift), which consumers place in
# Sources/Passport next to the manifest.
#
# The manifest points to the assets published on the GitHub release of this
# build (the tag being built, or the rolling pre-release for any other build),
# and pins the zip with its SHA-256 checksum, which is what
# `swift package compute-checksum` computes.
#
# Usage: create-swift-package <path/to/passport.xcframework.zip> <path/to/Package.swift>

__zip=$1
__output=$2
if [[ "${GITHUB_REF_TYPE:-}" == "tag" && -n "${GITHUB_REF_NAME:-}" ]]; then
	__tag="${GITHUB_REF_NAME}"
else
	__tag="rolling"
fi
__checksum=$(shasum -a 256 "${__zip}" | cut -d ' ' -f 1)

cat >"${__output}" <<MANIFEST
// swift-tools-version:5.9
// Generated by maven/ios/create-swift-package for ${__tag}; DO NOT EDIT.
import PackageDescription

let package = Package(
    name: "Passport",
    platforms: [.iOS(.v13)],
    products: [
        .library(name: "Passport", targets: ["Passport"]),
    ],
    targets: [
        .binaryTarget(
            name: "passport",
            url: "https://github.com/ooni/ooniprobe-rs/releases/download/${__tag}/passport.xcframework.zip",
            checksum: "${__checksum}"
        ),
        // UniFFI bindings: ooniprobe.swift from the same release.
        .target(
            name: "Passport",
            dependencies: ["passport"],
            path: "Sources/Passport"
        ),
    ]
)
MANIFEST
